{
  "name": "immigrate-to-brazil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:content": "node scripts/generate-content.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "extract:route-shell": "node scripts/extract-route-shell.js",
    "migrate:content": "node scripts/migrate-content.js",
    "sync:data": "npm run generate:content && node scripts/sync-static-data.js",
    "build:static": "npm run check",
    "check": "npm run sync:data && npm run validate",
    "validate": "node scripts/validate-site.js",
    "translate:pt": "npm run generate:content && python3 scripts/generate_pt.py",
    "translate:pt:all": "npm run generate:content && python3 scripts/generate_pt.py --force",
    "generate:text-map": "node scripts/extract-client-visible-text-map.js",
    "sitemap:webhook": "node scripts/run-sitemap-webhook.js",
    "fetch:heroes": "node scripts/fetch-pixabay-images.js",
    "images:sections": "python3 scripts/generate_section_images.py",
    "images:sections:bootstrap": "python3 scripts/generate_section_images.py --bootstrap-curated-library",
    "images:sections:download": "python3 scripts/generate_section_images.py --download",
    "seo:heroes": "node scripts/rewrite-hero-seo.js",
    "qa:matrix": "node scripts/qa-matrix.js",
    "qa:lighthouse": "node scripts/lighthouse-audit.js"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "lighthouse": "^13.0.3"
  }
}
