# Cloudflare Pages Headers Configuration
# Format: /path
#   Header-Name: value

# Content cache headers
/:locale(en|es|pt)/discover/:path*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/:locale(en|es|pt)/state-guides/:path*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/:locale(en|es|pt)/services/:path*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/:locale(en|es|pt)/faq/:path*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/:locale(en|es|pt)/about/:path*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

# Sitemap and robots cache
/sitemap.xml
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
